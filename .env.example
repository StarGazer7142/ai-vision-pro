# AI Video Platform environment template
# Copy to .env before running. Keep real API keys out of code, logs, and documents.

# Runtime profile
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5500

# Security
ALLOW_DEBUG_TOOLS=0
DEBUG_USERNAME=debug
DEBUG_PASSWORD=change-me-before-use
DEBUG_TOKEN_HOURS=2
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_MINUTES=15

# Logging and retention
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
RETENTION_DAYS=30
REPLAY_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=90

# Stream and inference performance
YOLO_WEIGHTS_PATH=models/yolo26s.pt
STREAM_MAX_FPS=12
STREAM_JPEG_QUALITY=76
STREAM_DETECTION_INTERVAL=4
STREAM_DETECTION_MAX_SIDE=960
STREAM_READ_FAILURE_REOPEN_AFTER=20

# Replay and uploads
REPLAY_ROOT=data/replay
REPLAY_LAYOUT={camera_id}/{date}/{hour}
UPLOAD_VIDEO_ROOT=data/uploads/videos

# Agent / LLM config
API_KEY=
BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
AGENT_ENABLE_LLM=1
TIMEOUT_SECONDS=12
AGENT_USE_JSON_RESPONSE_FORMAT=1

# MiMo video understanding (optional)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=45
MIMO_VIDEO_FPS=2
MIMO_VIDEO_MEDIA_RESOLUTION=default
MIMO_VIDEO_USE_BASE64=1
MIMO_MAX_COMPLETION_TOKENS=1024

# Existing video understanding backend switch
VIDEO_UNDERSTANDING_PROVIDER_MODE=mock_local
VIDEO_UNDERSTANDING_API_URL=
VIDEO_UNDERSTANDING_API_KEY=
VIDEO_UNDERSTANDING_MODEL=
VIDEO_UNDERSTANDING_TIMEOUT_SECONDS=12
VIDEO_UNDERSTANDING_SAMPLE_STRIDE=12
